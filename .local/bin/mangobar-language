#!/usr/bin/python3
import json
import subprocess

def abbreviation(layout):
    value = layout.lower()
    if any(word in value for word in ('persian', 'farsi', 'iran')) or value in ('ir', 'fa'):
        return 'Fa'
    if 'english' in value or value in ('us', 'en'):
        return 'En'
    return layout[:2].title() or '--'

if __name__ == '__main__':
    try:
        result = json.loads(subprocess.check_output(
            ['mmsg', 'get', 'keyboardlayout'], text=True, timeout=1,
            stderr=subprocess.DEVNULL))
        print('[' + abbreviation(result.get('layout', '')) + ']')
    except (OSError, ValueError, subprocess.SubprocessError):
        print('[--]')
