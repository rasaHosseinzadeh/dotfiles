#!/bin/sh

cmds="\
 lock,swaylock -f -c 222222
← leave Hyprland, hyprctl dispatch exit
 reboot,hyprshutdown -t 'Restarting...' --post-cmd 'reboot'
⏻ shutdown,hyprshutdown -t 'Shutting down...' --post-cmd 'shutdown -P 0'"

choice="$(echo "$cmds" | cut -d',' -f 1 | bemenu-custom -i -fn "Hack:size=20" -l 10)" || exit 1

eval "$(echo "$cmds" | grep "^$choice" | cut -d ',' -f2-)"
