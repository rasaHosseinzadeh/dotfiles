# Change default shell to dash
sudo ln -sfT /usr/bin/dash /usr/bin/sh

# Install yay manually before using it to install packages from ./aur
git clone https://aur.archlinux.org/yay.git /tmp/yay
cd /tmp/yay
makepkg -si

# Configure and enable UFW
sudo ufw default deny incoming
sudo ufw default allow outgoing
sudo ufw enable

# Time sync using systemd
sudo timedatectl set-ntp true

# The EFI system partition is mounted at /boot. fwupd should detect it. If it
# does not, set EspLocation=/boot under [fwupd] in /etc/fwupd/fwupd.conf.

# Hibernation is configured: HOOKS contains resume and GRUB_CMDLINE_LINUX
# contains the swap UUID. After changing either configuration, rebuild it:
# sudo mkinitcpio -P
# sudo grub-mkconfig -o /boot/grub/grub.cfg

# Run tlp
sudo systemctl enable --now tlp.service

# Enable periodic SSD trimming
sudo systemctl enable --now fstrim.timer

# Copy Firefox profile and chromecss
# Plugins: Dark reader - Multi container - sideberry - uBlock Origin

# Start cronie
sudo systemctl enable --now cronie.service
# Add cron for update (use crontab -e)
@daily export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u $USER)/bus; export DISPLAY=:0; . $HOME/.config/zsh/.zprofile; ${HOME}/.local/bin/checkup

# With sudo crontab -e
@reboot /usr/bin/updatedb

# Keep Docker available for work, but do not start it automatically or through
# socket activation. Start it only when needed.
sudo systemctl disable --now docker.socket docker.service
# When needed: sudo systemctl start docker

# Keep printing on demand without running cups.service continuously.
sudo systemctl disable --now cups.service
sudo systemctl enable --now cups.socket cups.path

# dhcpcd.service already manages wlan0; do not enable a duplicate instance.
sudo systemctl disable --now dhcpcd@wlan0.service

# symlink $HOME/.zshenv to .config/zsh/.zshenv
# Mask the rfkill service
sudo systemctl mask systemd-rfkill.service

# Mask the rfkill socket
sudo systemctl mask systemd-rfkill.socket


# Start MPD (Not necessary now as we use hyprland for it might change in future)
sudo systemctl enable --now mpd.service
