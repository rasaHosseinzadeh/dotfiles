{
  "layer": "top",
  "height": 15,
  "buffer-scale": 1,
  "modules-left": [
    "workspaces",
    "layout"
  ],
  "modules-center": [
    "clock#time"
  ],
  "modules-right": [
    "pulseaudio",
    "custom/wifi",
    "custom/speed",
    "cpu",
    "custom/temperature",
    "custom/bluetooth",
    "memory",
    "backlight",
    "battery",
    "custom/language",
    "tray"
  ],
  "workspaces": {
    "hide-empty": true,
    "tag-names": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "9"
    ],
    "on-click": "activate",
    "on-click-right": "toggle"
  },
  "layout": {
    "format": "{}"
  },
  "clock#time": {
    "format": "[{:L%a %b %d %H:%M}]"
  },
  "pulseaudio": {
    "format": "[{icon} {volume}%]",
    "format-muted": "[󰸈 muted]",
    "icons": [
      "",
      "",
      ""
    ],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "custom/bluetooth": {
    "exec": "mangobar-status bluetooth",
    "interval": 5,
    "format": "{}",
    "on-click": "bluetooth-toggle",
    "on-click-right": "mangobar-status bluetooth-notify"
  },
  "memory": {
    "format": "[󰍛 {}%]",
    "interval": 2
  },
  "cpu": {
    "format": "[ {usage}%]",
    "interval": 10
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "[ {percent}%]",
    "on-scroll-up": "brightnessctl set +2%",
    "on-scroll-down": "brightnessctl set 2%-"
  },
  "battery": {
    "format": "[{icon} {percent}%]",
    "icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "icon-charging": "󰂄",
    "icon-full": "󰁹"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 0
  },
  "custom/wifi": {
    "exec": "/home/rasa/.local/bin/mangobar-wifi",
    "interval": 5,
    "format": "{}",
    "on-click": "ghostty --class=com.rasa.nmtui -e nmtui connect",
    "max-length": 120
  },
  "custom/temperature": {
    "exec": "/home/rasa/.local/bin/mangobar-temperature",
    "interval": 5,
    "format": "{}"
  },
  "custom/language": {
    "exec": "/home/rasa/.local/bin/mangobar-language",
    "interval": 1,
    "format": "{}"
  },
  "custom/speed": {
    "exec": "/home/rasa/.local/bin/mangobar-speed",
    "interval": 2,
    "format": "{}"
  }
}
